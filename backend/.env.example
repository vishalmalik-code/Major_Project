# ---- service ----
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- database ----
DATABASE_URL=postgresql+psycopg:///llm_firewall?host=/var/run/postgresql

# ---- ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120

# ---- embeddings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- admin ----
ADMIN_TOKEN=change-me-local-only

# The one admin account -- created by scripts/seed_admin.py, hashed with
# bcrypt before it ever touches the database. Change this before any
# non-local deployment; it is never read by the frontend.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe123!

# ---- query window (QUERY-BASED, never time-based) ----
QUERY_WINDOW_SIZE=20
TIGHT_WINDOW_SIZE=10

# ---- risk bands ----
RISK_THRESHOLD_MEDIUM=30.0
RISK_THRESHOLD_HIGH=55.0
RISK_THRESHOLD_CRITICAL=80.0
THROTTLE_DELAY_SECONDS=5.0

# ---- risk update (query-based decay) ----
SUSPICION_THRESHOLD=0.35
BENIGN_THRESHOLD=0.15
GAIN_SCALE=18.0
DECAY_STEP=4.0

# ---- signal weights ----
WEIGHT_EXACT_REPETITION=1.0
WEIGHT_TEXT_SIMILARITY=0.8
WEIGHT_SEMANTIC_SIMILARITY=0.9
WEIGHT_SYSTEMATIC_MODIFICATION=1.2
WEIGHT_VALUE_PROGRESSION=1.2
WEIGHT_CONSTRAINT_PROGRESSION=1.1
WEIGHT_BOUNDARY_PROGRESSION=1.1
WEIGHT_BURST_RATE=0.5

# ---- attack pacing ----
FAST_DELAY_MAX=0.05
SLOW_DELAY_MIN=20.0
SLOW_DELAY_MAX=120.0
